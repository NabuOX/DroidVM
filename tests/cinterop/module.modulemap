module CDroidVMBridge {
    // The narrow door the Swift adapters reach through. Public by design.
    header "../../engine/include/DroidVMBridge.h"
    export *
}

module CDroidVMNative {
    // The engine's internal seams. Internal by design -- the Swift application never
    // includes this, but the host tests drive the six counters through it, which is what
    // makes them testable off-device.
    header "../../engine/native/droidvm_native.h"
    export *
}
